# Публичные параметры проекта Supabase.
# ANON KEY является публичным ключом и защищается политиками RLS.
# НИКОГДА не используйте здесь service_role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Необязательно. Базовый путь сборки для GitHub Pages.
# По умолчанию: /kf-portal/
# VITE_BASE=/kf-portal/
